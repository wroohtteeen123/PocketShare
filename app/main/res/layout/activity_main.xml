    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/navigation" android:theme="@style/BottomBarTheme" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/colorSurface" app:itemActiveIndicatorStyle="@style/BrandNavigationIndicator" app:itemIconTint="@color/navigation_colors" app:menu="@menu/navigation" app:labelVisibilityMode="labeled" android:minHeight="80dp" app:itemTextAppearanceActive="@style/TextAppearance.Material3.LabelMedium" app:itemTextAppearanceInactive="@style/TextAppearance.Material3.LabelMedium" app:itemIconSize="24dp" />
</LinearLayout>