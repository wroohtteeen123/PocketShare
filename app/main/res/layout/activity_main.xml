                            <com.google.android.material.button.MaterialButton android:id="@+id/manage_accounts" style="@style/SettingsAction" android:text="@string/accounts_title" />
                            <TextView android:id="@+id/accounts_summary" style="@style/PageCaption" />
                            <TextView style="@style/PageCaption" android:text="@string/accounts_description" />
                            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/allow_write" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/guest_write" android:textSize="16sp" android:textStyle="normal" />
                            <TextView android:id="@+id/access_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="" android:textSize="14sp" />
                            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/require_encryption" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/require_encryption" android:textSize="16sp" android:textStyle="normal" />
                            <TextView style="@style/PageCaption" android:text="@string/encryption_hint" />
                            <TextView style="@style/SectionTitle" android:text="@string/server_copy_title" />
                            <TextView style="@style/PageCaption" android:text="@string/server_copy_hint" />
                            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/directory_cache" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/directory_cache_title" android:textSize="16sp" android:textStyle="normal" />
                            <TextView style="@style/PageCaption" android:text="@string/directory_cache_hint" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <include layout="@layout/settings_support" />
